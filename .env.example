# Copy to .env and adjust. Every setting is optional.

# --- Server
# HOST=127.0.0.1
# PORT=8000

# --- OCR engines
# OCR_SECONDARY=auto          # auto | apple | windows | none
# TESSDATA_DIR=./tessdata
# TESSERACT_LANG=eng
# TESSERACT_CMD=              # only for a system tesseract via pytesseract, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# WINDOWS_OCR_LANGUAGE=en-US

# --- Optional LLM arbiter (consulted only for letters the OCR engines are unsure about)
# Any OpenAI-compatible endpoint with a vision-capable model works.
# Your LAN gateway:
# LLM_BASE_URL=http://192.168.0.226:8000/v1
# LLM_API_KEY=change-me-gateway-key
# LLM_MODEL=gemma
# Or local Ollama:    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=gemma3:4b
# Or LM Studio:       LLM_BASE_URL=http://localhost:1234/v1
# LLM_TIMEOUT=15
